class Ledger {
  int balance = 0;

  void deposit(int amount) {
    balance = balance + amount;
  }

  int total() {
    return balance;
  }
}

void inspect(lend Ledger ledger) {
  print(ledger.total());
}

void main() {
  var ledger = new Ledger();
  ledger.deposit(10);
  ledger.deposit(25);
  inspect(lend ledger);
  print(ledger.total());
}
